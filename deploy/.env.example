# NimbusDrive 全栈部署凭据模板（deploy/.env）。
# 复制为 .env 并修改；不创建则使用下列默认值（仅限本地部署）。
# 远程/生产部署必须覆盖全部四项，且避免密码含空格或引号（PG DSN key=value 形式）。

# PostgreSQL 密码（infra 栈与双后端共享）
POSTGRES_PASSWORD=nimbus

# MinIO 对象存储凭据（infra 栈与双后端共享）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT 签名密钥（生产必须换成强随机值，如 openssl rand -hex 32）
JWT_SECRET=change-me-in-prod

# 浏览器可达的 MinIO 端点（预签名下载 URL 用）。
# 单机本地部署默认 localhost:9000；域名/HTTPS 部署改为 files.example.com 等。
MINIO_PUBLIC_ENDPOINT=localhost:9000

# 基础镜像源前缀（构建 Go/前端镜像用）。Docker Hub 直连受限的环境切镜像代理，
# 如 docker.m.daocloud.io；海外环境保持默认 docker.io。
#DOCKER_REGISTRY=docker.m.daocloud.io

# Go 模块代理 / npm 源镜像（国内受限网络示例）：
#GOPROXY=https://goproxy.cn,direct
#NPM_REGISTRY=https://registry.npmmirror.com
